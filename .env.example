# Copy to .env and adjust. Consumed by docker-compose.yml (host-side interpolation)
# and by the pipeline tooling.

# ---------------------------------------------------------------------------
# Storage root — lives OUTSIDE this repo so the code stays clean / GitHub-ready.
#   Windows (Docker Desktop):  STORAGE_ROOT=D:\MLOps_storage
#   WSL / Linux:               STORAGE_ROOT=/mnt/d/MLOps_storage
# Inside every container it is ALWAYS mounted at /workspace/storage.
# ---------------------------------------------------------------------------
STORAGE_ROOT=D:\MLOps_storage

# MLflow tracking server (compose service name on the internal network).
MLFLOW_TRACKING_URI=http://mlflow:5000

# Windows DCS Runner Agent endpoint (host-side capture; see docs/dcs_capture.md).
DCS_AGENT_URL=http://host.docker.internal:8765
